{
  "//": "Shape reference only (spec §11.1). Placeholder values ONLY — real values come from dotnet user-secrets in dev and Key Vault in prod.",

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=aequitas;Username=postgres;Password=CHANGE_ME"
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "QueueName": "report-jobs",
    "CacheContainer": "cache",
    "ReportsContainer": "reports"
  },
  "ModelRouting": {
    "Providers": {
      "groq": {
        "BaseUrl": "https://api.groq.com/openai/v1",
        "KeyRef": "GROQ_API_KEY",
        "DailyTokenBudget": 0
      },
      "azure": {
        "BaseUrl": "CHANGE_ME",
        "KeyRef": "AZURE_LLM_KEY",
        "Enabled": false
      },
      "byok": {
        "BaseUrl": "per-request",
        "KeyRef": "per-request"
      }
    },
    "Tasks": {
      "extraction": { "Provider": "groq", "Model": "CHANGE_ME" },
      "synthesis": { "Provider": "groq", "Model": "CHANGE_ME" },
      "titles": { "Provider": "groq", "Model": "CHANGE_ME" }
    }
  },
  "Turnstile": {
    "SiteKey": "CHANGE_ME",
    "SecretKey": "CHANGE_ME"
  },
  "OriginAuth": {
    "Expected": "CHANGE_ME"
  },
  "Revalidate": {
    "Url": "https://app.example.com/api/revalidate",
    "Secret": "CHANGE_ME"
  },
  "Generation": {
    "Enabled": true,
    "PerUserDailyLimit": 3,
    "GlobalDailyLimit": 15
  },
  "Edgar": {
    "UserAgent": "AequitasResearch/0.1 (you@example.com)"
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.example.com" ]
  }
}
