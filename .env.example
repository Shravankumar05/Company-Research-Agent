# Aequitas Research — example configuration (spec §15)
# Copy to `.env` (gitignored) for local docker/compose use, OR prefer
# `dotnet user-secrets` for backend dev. NEVER put real values in this file.

# ---- Database ----
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=aequitas;Username=postgres;Password=CHANGE_ME

# ---- Azure Storage (local dev = Azurite emulator) ----
Storage__ConnectionString=UseDevelopmentStorage=true
Storage__QueueName=report-jobs
Storage__CacheContainer=cache
Storage__ReportsContainer=reports

# ---- LLM providers (spec §8.1) ----
GROQ_API_KEY=CHANGE_ME
ModelRouting__Providers__groq__BaseUrl=https://api.groq.com/openai/v1
# VERIFY the real daily limit in the Groq console before relying on it
ModelRouting__Providers__groq__DailyTokenBudget=0

# ---- Cloudflare Turnstile (spec §10.3.6) ----
Turnstile__SiteKey=CHANGE_ME
Turnstile__SecretKey=CHANGE_ME

# ---- Origin lock: Cloudflare transform rule injects this header (spec §10.3.5) ----
OriginAuth__Expected=CHANGE_ME

# ---- Worker -> frontend on-demand revalidation webhook (spec §9) ----
Revalidate__Secret=CHANGE_ME
Revalidate__Url=https://app.example.com/api/revalidate

# ---- Kill switch + quotas (spec §12) ----
Generation__Enabled=true
Generation__PerUserDailyLimit=3
Generation__GlobalDailyLimit=15

# ---- SEC EDGAR requires a declared User-Agent (spec §8.2) ----
Edgar__UserAgent=AequitasResearch/0.1 (you@example.com)

# ---- Frontend (Vercel env vars; NEXT_PUBLIC_* are shipped to the browser) ----
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME
